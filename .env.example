# Tauri updater signing — required for `npm run build:signed`
# Copy this file to `.env` and fill in your values.
#
# Get the private key from ~/.tauri/godotharbor.key (file content, single base64 string)
# Get the password from the admin who generated the key (or yourself if you ran `tauri signer generate`)
#
# WARNING: Never commit `.env` — it contains the private key.

TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
