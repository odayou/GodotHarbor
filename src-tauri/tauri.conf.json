{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Godot Harbor",
  "version": "2.2.6",
  "identifier": "com.godotharbor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Godot Harbor",
        "width": 1200,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"]
        }
      }
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "mainBinaryName": "godot-harbor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": false,
    "resources": [
      "templates/**/*",
      "modules/**/*"
    ]
  },

  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1QTUwQkE1QjlCOTExMTUKUldRVkVibTVwUXVsRmFDWG4wUzgvbjIzaXBnS0QrRERBVnpHbnc2Z2xBWmF4RkU0aEliYUJUajMK",
      "endpoints": [
        "https://github.com/odayou/GodotHarbor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}