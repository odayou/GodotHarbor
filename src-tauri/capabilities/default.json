{
  "$schema": "https://schema.tauri.app/2/capability.json",
  "identifier": "default",
  "description": "Default permissions for Godot Harbor",
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    {
      "identifier": "dialog:allow-open",
      "allow": ["local://**", "http://localhost:1420/**"]
    },
    {
      "identifier": "dialog:allow-save",
      "allow": ["local://**", "http://localhost:1420/**"]
    },
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "dialog:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": ["*"]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": ["*"]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": ["*"]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": ["*"]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": ["*"]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": ["*"]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": ["*"]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": ["*"]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": ["*"]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": ["*"]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": ["*"]
    },
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    "fs:scope-home-recursive",
    "shell:allow-open",
    "shell:default",
    "core:default",
    "core:event:default",
    "core:image:default",
    "core:menu:default",
    "core:path:default",
    "core:resources:default",
    "core:tray:default",
    "core:webview:default",
    "core:window:default"
  ]
}
